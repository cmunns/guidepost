{
  "name": "@cmunns/guidepost",
  "version": "0.1.4",
  "description": "Accessible product tours built on native browser primitives — Popover API, CSS anchor positioning, and animated clip-path spotlights. No positioning dependency.",
  "type": "module",
  "license": "MIT",
  "author": "cmunns",
  "homepage": "https://github.com/cmunns/guidepost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmunns/guidepost.git"
  },
  "bugs": {
    "url": "https://github.com/cmunns/guidepost/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./guidepost.css": "./dist/guidepost.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "tour",
    "onboarding",
    "walkthrough",
    "product-tour",
    "accessibility",
    "a11y",
    "popover",
    "anchor-positioning"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "build": "tsup && node scripts/emit-css.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "test": "playwright test",
    "prepublishOnly": "npm run build",
    "compare": "node scripts/compare.mjs",
    "size": "node scripts/size.mjs",
    "dev:demo": "npm run dev --workspace=demo",
    "dev:docs": "npm run dev --workspace=docs",
    "build:demo": "npm run build && npm run build --workspace=demo",
    "build:docs": "npm run build && npm run build --workspace=docs",
    "build:sites": "npm run build && npm run build --workspace=demo && npm run build --workspace=docs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
